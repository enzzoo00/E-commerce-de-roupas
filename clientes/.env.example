# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.
PORT=3001

# Banco (valores abaixo batem com o docker-compose.yml desta pasta)
DB_HOST=localhost
DB_PORT=3306
DB_USER=clientes_user
DB_PASSWORD=clientes_pass
DB_NAME=clientes_db
# true em bancos hospedados que exigem SSL
DB_SSL=false

# Gere um segredo com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=2h

# Origens permitidas no CORS, separadas por vírgula (frontend local e da Vercel)
FRONTEND_URL=http://localhost:5173

# Opcional: se preenchida, o serviço de Pedidos precisa enviar o header X-Service-Key
SERVICE_KEY=
