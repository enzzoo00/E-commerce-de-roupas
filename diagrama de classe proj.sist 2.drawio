        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\ninterface MetodoPagamento {\n    +processar(valor: float): ResultadoPagamento\n}\n\nclass CartaoCredito implements MetodoPagamento {\n    -numeroCartao: String\n    -nomeTitular: String\n    -validade: String\n    -cvv: String\n    +processar(valor: float): ResultadoPagamento\n}\n\nclass Pix implements MetodoPagamento {\n    -chavePix: String\n    +processar(valor: float): ResultadoPagamento\n}\n\nenum StatusPagamento {\n    PENDENTE\n    APROVADO\n    RECUSADO\n}\n\nclass ResultadoPagamento {\n    +sucesso: boolean\n    +mensagemErro: String\n    +transacaoId: String\n}\n\nclass Endereco {\n    -rua: String\n    -numero: String\n    -bairro: String\n    -cidade: String\n    -estado: String\n    -cep: String\n}\n\nclass Usuario {\n    -id: int\n    -nome: String\n    -email: String\n    -senhaHash: String\n    +cadastrar(): boolean\n    +login(): boolean\n    +logout(): void\n    +atualizarPerfil(): boolean\n    +adicionarEndereco(endereco: Endereco): void\n}\n\nclass Categoria {\n    -id: int\n    -nome: String\n}\n\nclass Produto {\n    -id: int\n    -nome: String\n    -descricao: String\n    -precoBase: float\n    +buscarPorNome(termo: String): List~Produto~\n    +filtrarPorCategoria(categoria: Categoria): List~Produto~\n}\n\nclass ItemEstoque {\n    -id: int\n    -tamanho: String\n    -cor: String\n    -quantidadeEstoque: int\n    +verificarDisponibilidade(qtd: int): boolean\n    +deduzirEstoque(qtd: int): void\n}\n\nclass ItemCarrinho {\n    -quantidade: int\n    -tamanhoSelecionado: String\n    -corSelecionada: String\n    +calcularSubtotal(): float\n}\n\nclass Carrinho {\n    -id: int\n    +adicionarItem(produto: Produto, tam: String, cor: String, qtd: int): void\n    +removerItem(item: ItemCarrinho): void\n    +alterarQuantidade(item: ItemCarrinho, qtd: int): void\n    +calcularTotal(): float\n    +validarEstoque(): boolean\n}\n\nclass Pedido {\n    -id: int\n    -dataCriacao: Date\n    -valorTotal: float\n    -statusPagamento: StatusPagamento\n    +criarPedido(): void\n    +processarPagamento(metodo: MetodoPagamento): boolean\n    +confirmarCompra(): void\n}\n\nUsuario \&quot;1\&quot; -- \&quot;0..*\&quot; Endereco : possui &gt;\nUsuario \&quot;1\&quot; -- \&quot;0..1\&quot; Carrinho : detém &gt;\nUsuario \&quot;1\&quot; -- \&quot;0..*\&quot; Pedido : realiza &gt;\n\nProduto \&quot;0..*\&quot; -- \&quot;1\&quot; Categoria : pertence a &gt;\nProduto \&quot;1\&quot; -- \&quot;1..*\&quot; ItemEstoque : possui variações em &gt;\n\nCarrinho \&quot;1\&quot; *-- \&quot;0..*\&quot; ItemCarrinho : contém &gt;\nItemCarrinho \&quot;0..*\&quot; -- \&quot;1\&quot; Produto : referencia &gt;\n\nPedido \&quot;1\&quot; *-- \&quot;1..*\&quot; ItemCarrinho : contém &gt;\nPedido \&quot;1\&quot; -- \&quot;1\&quot; Endereco : entrega em &gt;\nPedido \&quot;1\&quot; -- \&quot;1\&quot; MetodoPagamento : utiliza &gt;\nMetodoPagamento ..&gt; ResultadoPagamento : gera &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bFfm-eQN3pBRAG17OVE9-1">
